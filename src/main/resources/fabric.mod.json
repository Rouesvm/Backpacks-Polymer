{
  "schemaVersion": 1,
  "id": "serverbackpacks",
  "version": "${version}",

  "name": "Server Backpacks",
  "description": "Backpacks for your server!!",
  "authors": [
    "Oliver-makes-code",
    "Rouesvm"
  ],

  "license": "MIT",
  "icon": "assets/serverbackpacks/icon.png",

  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.rouesvm.servback.datagen.BackpacksDataGenerator"
    ],
    "main": [
      "com.rouesvm.servback.Main"
    ]
  },
  "mixins": [
    "servback.mixin.json"
  ],

  "depends": {
    "fabricloader": "*",
    "polymer-bundled": ">=0.11.8+1.21.4",
    "minecraft": ">=1.21.4",
    "java": ">=21"
  }
}
