{
  "schemaVersion": 1,
  "id": "serverbackpacks",
  "version": "${version}",

  "name": "Server Backpacks",
  "description": "A configurable backpack mod for your server.",
  "authors": [
    "Rouesvm",
    "Original Author: Oliver-makes-code"
  ],

  "license": "MIT",
  "icon": "icon.png",

  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.rouesvm.servback.datagen.BackpacksDataGenerator"
    ],
    "main": [
      "com.rouesvm.servback.ServerBackpacks"
    ]
  },
  "mixins": [
    "servback.mixin.json"
  ],

  "depends": {
    "fabricloader": "*",
    "fabric-api": ">=0.133.1",
    "minecraft": ">1.21.8",
    "polymer-core": ">=0.14.0",
    "polymer-resource-pack": ">=0.14.0",
    "java": ">=21"
  }
}
